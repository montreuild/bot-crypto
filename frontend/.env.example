# URL du backend FastAPI (par défaut : local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL du WebSocket backend
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Clé API (optionnelle — si config.yaml a web.api_key défini)
# En local sans clé, le backend accepte les requêtes depuis localhost
NEXT_PUBLIC_API_KEY=

# Port du frontend Next.js (par défaut : 3000)
PORT=3000
