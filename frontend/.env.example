# URL du backend FastAPI (par défaut : local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL du WebSocket backend
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Auth : plus de clé API côté client (S1-05 — une variable NEXT_PUBLIC_* est
# visible dans le bundle JS). Le cookie HttpOnly api_key, posé par les pages
# web quand config.yaml a web.api_key défini, est envoyé automatiquement.
# En local sans clé, le backend accepte les requêtes depuis localhost.

# Port du frontend Next.js (par défaut : 3000)
PORT=3000
