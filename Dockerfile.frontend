# Crypto Bot — image frontend Next.js (standalone)
#
# Build (contexte = racine du dépôt) :
#   docker build -f Dockerfile.frontend -t crypto-bot:web .
# Ou : docker compose --profile full build web

# Base Alpine sur les TROIS étages, pas seulement le runner : le `standalone`
# embarque les modules natifs (sharp) compilés à l'étage builder. Les bâtir
# sous glibc pour les exécuter sous musl donnerait un binaire illisible.
# `libc6-compat` est la recommandation officielle de Next.js pour Alpine.
# Gain mesuré : base 246 Mo (bookworm-slim) → ~60 Mo.
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
# URL interne du backend (réseau compose) — surchargée au runtime via env.
ARG BOT_API_URL=http://api:8000
# WS : vide par défaut = same-origin (`ws(s)://<page>/ws`), servi par le rewrite
# `/ws` de next.config.mjs. Un défaut cross-origin laisserait le cookie d'auth
# HttpOnly derrière et le backend refuserait la connexion par un 403.
ARG NEXT_PUBLIC_WS_URL=
ENV BOT_API_URL=$BOT_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# `adduser` d'Alpine (busybox) — `useradd` de shadow n'existe pas ici.
RUN adduser -D -u 10001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
# BOT_API_URL et WEB_API_KEY fournis par compose au runtime (proxy same-origin).
CMD ["node", "server.js"]
