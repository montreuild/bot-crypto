# ═══════════════════════════════════════════════════════════════
#  crypto-bot.service — Systemd unit pour le bot de trading
#
#  Prérequis : le venv Python 3.12 doit être créé à l'avance :
#    python3.12 -m venv /opt/crypto_bot/.venv
#    source /opt/crypto_bot/.venv/bin/activate
#    pip install -r requirements.txt
#
#  Installation :
#    sudo cp deploy/crypto-bot.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now crypto-bot
# ═══════════════════════════════════════════════════════════════

[Unit]
Description=Crypto Trading Bot (Python 3.12)
Documentation=https://github.com/ton-repo/crypto-bot
After=network-online.target
Wants=network-online.target
PartOf=network.target

[Service]
# ── Identité ────────────────────────────────────────────────
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/crypto_bot

# ── Commandes — utilise EXCLUSIVEMENT le venv Python 3.12 ───
ExecStart=/opt/crypto_bot/.venv/bin/python cli.py --live
ExecStop=/bin/kill -TERM $MAINPID

# ── Notification de crash ────────────────────────────────────
ExecStopPost=/opt/crypto_bot/.venv/bin/python /opt/crypto_bot/deploy/notify-crash.py

# ── Politique de redémarrage ─────────────────────────────────
Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=300
StartLimitBurst=5

# ── Ressources (ARM A1 : 4 vCPU / 24 GB) ───────────────────
MemoryLimit=19G
CPUWeight=200

# ── Journalisation ──────────────────────────────────────────
StandardOutput=append:/opt/crypto_bot/logs/bot.log
StandardError=append:/opt/crypto_bot/logs/bot.log

# ── Variables d'environnement ───────────────────────────────
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/crypto_bot"
Environment="VIRTUAL_ENV=/opt/crypto_bot/.venv"
Environment="PATH=/opt/crypto_bot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# ── Clés API — fichier protégé chmod 600, jamais versionné ──
# Créer /opt/crypto_bot/.env :
#   BINANCE_API_KEY=votre_clé
#   BINANCE_API_SECRET=votre_secret
EnvironmentFile=-/opt/crypto_bot/.env

# ── Sécurité ────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
