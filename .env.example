# ── Crypto Bot — variables d'environnement ───────────────────────────────
# Copier vers `.env` (jamais versionné) :
#   cp .env.example .env
#   # ou : scripts/docker-up.* qui le génère avec une clé aléatoire
#
# Docker Compose et `app/core/config.py` (python-dotenv) lisent ce fichier.
# Une variable déjà exportée dans le shell / orchestrateur reste prioritaire.

# Environnement applicatif : dev | test | prod
# ENV=prod désactive /api/docs et OpenAPI (SEC-006).
ENV=dev

# Clé API web (X-API-Key / cookie). OBLIGATOIRE si web.host est 0.0.0.0.
# Génération :  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_KEY=change-me-generate-a-secret

# Dev local uniquement : autorise host ouvert SANS api_key (SEC-003).
# Ne jamais mettre à 1 en production.
ALLOW_INSECURE_WEB=0

# URL du frontend Next (CORS / messages API).
FRONTEND_URL=http://localhost:3000

# Ports / bind publiés par docker compose (hôte).
# Prod derrière nginx : API_HOST_BIND=127.0.0.1
API_HOST_BIND=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# WebSocket vu par le navigateur — À LAISSER VIDE dans le cas général.
#
# Par défaut le client se connecte en SAME-ORIGIN (`ws(s)://<page>/ws`), servi
# par le rewrite `/ws` de next.config.mjs en dev et par `location /ws` de
# nginx en prod. C'est ce qui permet au cookie HttpOnly `api_key`, posé sur
# l'origine Next, d'accompagner la poignée de main : une URL cross-origin
# (ex. ws://localhost:8000/ws) laisse le cookie derrière et le backend
# répond 403.
#
# Ne renseigner que si le WS est réellement exposé sur un AUTRE hôte que les
# pages — auquel cas il faut aussi régler l'authentification de ce WS.
# NEXT_PUBLIC_WS_URL=

# ── Exchange (optionnel en paper) ─────────────────────────────────────────
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSWORD=

# ── Notifications (optionnel) ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
